# ==========================================
# TUMIZ RADAR - CẤU HÌNH BIẾN MÔI TRƯỜNG (.env)
# ==========================================
# Dự án hoạt động mặc định 100% với mạng lưới ADS-B cộng đồng miễn phí và Planespotters.
# Các biến dưới đây là TÙY CHỌN (Optional) nếu bạn muốn mở rộng tích hợp nguồn dữ liệu phụ.

# URL chính thức của website khi deploy lên Vercel
NEXT_PUBLIC_SITE_URL=https://tumiz-radar.vercel.app

# (Tùy chọn) API Key AviationStack nếu bạn muốn tra cứu chi tiết cổng bay/băng chuyền
# Đăng ký tại: https://aviationstack.com
# AVIATIONSTACK_API_KEY=your_api_key_here

# (Tùy chọn) OpenSky Network OAuth2 Credentials (chỉ cần khi muốn mở rộng hạn mức OpenSky)
# Đăng ký tại: https://opensky-network.org
# OPENSKY_CLIENT_ID=your_client_id_here
# OPENSKY_CLIENT_SECRET=your_client_secret_here
